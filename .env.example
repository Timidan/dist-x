# Copy this file to .env.local and fill in real values.

# RPC suggestion:
# - standalone localnet: http://127.0.0.1:3040
LEZ_RPC_URL=http://127.0.0.1:3040
LEZ_DEPLOYER_WALLET=Public/YOUR_FUNDED_LEZ_ACCOUNT
# Localnet helper:
# cargo run -q -p distributionx-cli -- create-wallet --out-dir "$DISTRIBUTIONX_STATE_DIR"
# Optional localnet/testnet override.
# Set to `auto` or leave empty to use the bundled LEZ wallet deploy helper.
# A custom command should print {"program_id":"..."} when the deploy tool exposes one.
LEZ_DEPLOY_COMMAND=auto

# The receipt-verifying SPEL binary is larger than LEZ's 1 MiB debug default.
# The standalone sequencer helper reads this value when starting localnet.
DISTRIBUTIONX_SEQUENCER_MAX_BLOCK_SIZE='4 MiB'

DISTRIBUTIONX_AIRDROP_NAME=demo-airdrop
DISTRIBUTIONX_STATE_DIR=target/distributionx-testnet

# Basecamp can create these interactively. scripts/e2e.sh derives token and
# recovery values from the current sample fixture when they are unset.
# DISTRIBUTIONX_TOKEN_ID=Public/YOUR_TEST_TOKEN_ID
# Localnet helper:
# cargo run -q -p distributionx-cli -- token-id --name "$DISTRIBUTIONX_AIRDROP_NAME-token"
# DISTRIBUTIONX_RECOVERY_ADDRESS=Public/YOUR_RECOVERY_ACCOUNT
DISTRIBUTIONX_FUND_AMOUNT=3000
DISTRIBUTIONX_EXPIRY_UNIX=1893456000

# Optional pre-fill paths forwarded to the Basecamp app.
DISTRIBUTIONX_ELIGIBILITY_CSV=target/distributionx-testnet/eligible.csv
DISTRIBUTIONX_DESTINATION_PACKET=target/distributionx-testnet/shielded_destination.json
# Optional: for localnet public-claim E2E, set this to an initialized Public/*
# LEZ account. scripts/e2e.sh defaults it to LEZ_DEPLOYER_WALLET on localnet.
# Leave unset when using a shielded destination/private claim path.
# DISTRIBUTIONX_CLAIM_DESTINATION_COMMITMENT=Public/YOUR_INITIALIZED_RECIPIENT
DISTRIBUTIONX_CLAIM_LINK=
DISTRIBUTIONX_CLAIM_BUNDLE=target/distributionx-testnet/bundle.json

DISTRIBUTIONX_RELAYER_URL=localnet
# `prove` writes this file; `claim` reads it.
DISTRIBUTIONX_SERIALIZED_LEZ_TX=target/distributionx-testnet/claim.tx
# Optional for clean CI clones: base64 content to materialize at
# DISTRIBUTIONX_SERIALIZED_LEZ_TX before claim preflight.
DISTRIBUTIONX_SERIALIZED_LEZ_TX_BASE64=

# Required for real init, fund, and claim transactions on localnet and testnet.
# Each command must read the JSON payload on stdin and print JSON containing `tx_id`.
DISTRIBUTIONX_INIT_SUBMIT_COMMAND='bash scripts/local-submit.sh init'
DISTRIBUTIONX_FUND_SUBMIT_COMMAND='bash scripts/local-submit.sh fund'
DISTRIBUTIONX_CLAIM_SUBMIT_COMMAND='bash scripts/local-submit.sh claim'
DISTRIBUTIONX_CLOSE_SUBMIT_COMMAND='bash scripts/local-submit.sh close'

# Guarded CI/localnet run. Fails when invoked without a real sequencer
# unless DISTRIBUTIONX_LOCALNET_E2E_ALLOW_SKIP=1 is set explicitly.
# `scripts/standalone-sequencer.sh` builds and runs the local LEZ sequencer.
DISTRIBUTIONX_LEZ_SEQUENCER_BIN=
DISTRIBUTIONX_LEZ_SEQUENCER_ARGS=
DISTRIBUTIONX_LEZ_SEQUENCER_START_COMMAND='bash scripts/standalone-sequencer.sh restart --clean'
DISTRIBUTIONX_LEZ_SEQUENCER_STOP_COMMAND='bash scripts/standalone-sequencer.sh stop'
DISTRIBUTIONX_LOCALNET_RPC_URL=http://127.0.0.1:3040
DISTRIBUTIONX_LOCALNET_E2E_ALLOW_SKIP=0
